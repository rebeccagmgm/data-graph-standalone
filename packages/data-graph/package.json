{
  "name": "data-graph",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Evidence-bounded consumer projections and graph queries for sql-static-lineage artifacts.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:real-artifact": "vitest run tests/real-artifact-closed-loop.test.ts --reporter=verbose",
    "format": "prettier --write package.json README.md src tests",
    "format:check": "prettier --check package.json README.md src tests",
    "query": "tsx src/project-graph/query/file-query-cli.ts",
    "project-topology": "tsx src/project-graph/project-topology-cli.ts",
    "project-topology-view": "tsx src/project-graph/project-topology-view-cli.ts",
    "field-evidence-graph": "tsx src/project-graph/field-evidence/field-evidence-cli.ts",
    "target-causal-overlay": "tsx src/project-graph/target-causal-overlay/target-causal-overlay-cli.ts",
    "union-continuation-v2": "tsx src/project-graph/topology/task-local-union/union-continuation-v2-cli.ts",
    "union-continuation-index": "tsx src/project-graph/topology/task-local-union/union-continuation-index-cli.ts"
  },
  "dependencies": {
    "neo4j-driver": "^6.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "prettier": "^3.8.3",
    "tsx": "^4.22.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.8"
  }
}
