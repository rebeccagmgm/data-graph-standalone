{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sql-static-lineage.local/schemas/task-input-pack-table.schema.json",
  "title": "Table Input Pack V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "stableTableId",
    "platform",
    "dataSource",
    "qualifiedName",
    "objectType",
    "ddlFile",
    "collectedAt",
    "contentHash"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "stableTableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[^\\\\/:*?\"<>|\\u0000-\\u001f. ].*[^. ]$|^[^\\\\/:*?\"<>|\\u0000-\\u001f. ]$"
    },
    "platform": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "guid": { "type": "string", "minLength": 1 },
    "dataSource": { "type": "string", "minLength": 1 },
    "qualifiedName": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^@\\s]+$"
    },
    "schema": { "type": ["string", "null"], "minLength": 1 },
    "name": { "type": ["string", "null"], "minLength": 1 },
    "description": { "type": ["string", "null"], "minLength": 1 },
    "objectType": { "type": "string", "minLength": 1 },
    "status": { "type": ["string", "null"], "minLength": 1 },
    "primaryKey": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "partitionFields": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "ddlFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "evidenceProvider"],
      "properties": {
        "path": { "const": "ddl.sql" },
        "sha256": { "pattern": "^[a-f0-9]{64}$" },
        "evidenceProvider": { "type": "string", "minLength": 1 }
      }
    },
    "evidenceProvider": { "type": "string", "minLength": 1 },
    "collectedAt": { "type": "string", "minLength": 1 },
    "contentHash": { "pattern": "^[a-f0-9]{64}$" }
  }
}
